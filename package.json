{
  "name": "@cryptography-research/iacr-mcp",
  "version": "0.1.0",
  "description": "Research-grade MCP server for the IACR Cryptology ePrint Archive",
  "type": "module",
  "bin": { "iacr-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "setup": "npm run build && npm run ingest && npm run check",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run build && npm test"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "cheerio": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
